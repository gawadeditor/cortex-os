# hypogeum-brain environment configuration
# Copy to .env and populate before running any pipeline milestone.
# Never commit .env to version control.
# All variable names are authoritative per provider-architecture.md §5.

# =============================================================================
# T0.1 — CONFIRMED 2026-06-01 (query: GET https://openrouter.ai/api/v1/models)
# =============================================================================

# OpenRouter model slugs — confirmed exact IDs from live API response
OPENROUTER_SONNET_MODEL_ID=anthropic/claude-sonnet-4.6
OPENROUTER_OPUS_MODEL_ID=anthropic/claude-opus-4.6

# For reference (evidence-first Haiku routing — confirm at M2/M4 before use):
# OPENROUTER_HAIKU_MODEL_ID=anthropic/claude-haiku-4.5

# =============================================================================
# OPENROUTER (all agents — LLM routing layer)
# =============================================================================

OPENROUTER_API_KEY=                # Required — routes all LLM calls in production
OPENROUTER_APP_NAME=hypogeum-brain # Optional — identifies this app to OpenRouter
OPENROUTER_FALLBACK_MODEL=         # Optional — fallback model if primary is unavailable

# =============================================================================
# PERPLEXITY (Research Director — discovery only)
# =============================================================================

PERPLEXITY_API_KEY=                # Required
PERPLEXITY_MODEL=sonar-pro         # Default: sonar-pro per perplexity-integration.md
PERPLEXITY_MAX_TOKENS=             # Optional — response length control

# =============================================================================
# MUAPI (Visual Package Director — video generation)
# =============================================================================

MUAPI_API_KEY=                     # Required
MUAPI_DEFAULT_TIER=2               # Optional — quality tier 1/2/3; default 2
MUAPI_TIMEOUT_SECONDS=120          # Optional — generation timeout before retry
MUAPI_WEBHOOK_URL=                 # Optional — async callback for generation completion

# M5.6 — Cost guardrails (recommended for all runs; required before Episode Zero)
MUAPI_EPISODE_BUDGET_CREDITS=      # Hard cap on total credits per episode run (0 = unlimited). Recommended: 10 for ep_000, 50 for production
MUAPI_SCENE_BUDGET_CREDITS=        # Hard cap on credits per scene across all attempts (0 = unlimited). Recommended: 3.0
MUAPI_MAX_PAID_ATTEMPTS_PER_SCENE= # Max paid submissions per scene_id (0 = unlimited). Recommended: 1 for ep_000, 2 for production
EPISODE_ZERO_MAX_SCENES=           # Truncate scene list for ep_000 validation runs (0 = no cap). Recommended: 6
MUAPI_CHEAP_MODE=false             # true = skip T1/T2, use veo3-fast-text-to-video only ($0.60/clip); disables paid fallback chain
MUAPI_RUNWAY_ONLY_MODE=false       # true = force T2 (runway-text-to-video, $0.15/clip) for all video scenes; Episode Zero Lite recommended setting
MUAPI_DRY_RUN=false                # true = no real API calls; returns fake request IDs for pipeline testing at zero cost
MUAPI_ALLOW_PAID_FALLBACKS=false   # DEFAULT false — automatic paid fallback is disabled. Set true only in production when fallback is acceptable. Always false for ep_000.

# Smoke Test Mode — minimal end-to-end run with capped scene/beat/thumbnail counts
SMOKE_TEST_MODE=false              # true = master switch; auto-sets EPISODE_ZERO_MAX_SCENES=2 and MUAPI_RUNWAY_ONLY_MODE=true unless already overridden
SMOKE_TEST_MAX_NARRATION_BEATS=0   # 0 = unlimited; set to 2–3 for smoke run (caps main narration beats before ElevenLabs calls)

# =============================================================================
# ELEVENLABS (Audio Agent — narration; Assembly Agent — music)
# =============================================================================

ELEVENLABS_API_KEY=                # Required — shared by narration and music generation
ELEVENLABS_VOICE_ID=j9jfwdrw7BRfcR43Qohk  # PINNED 2026-06-04 — production narrator voice; irreversible channel identity decision; do not change between episodes
ELEVENLABS_MODEL_ID=               # Optional — synthesis model variant
ELEVENLABS_STABILITY=              # Optional — voice stability (0.0–1.0)
ELEVENLABS_SIMILARITY_BOOST=       # Optional — speaker similarity boost (0.0–1.0)

ELEVENLABS_MUSIC_MODEL_ID=         # Optional — music generation model variant
ELEVENLABS_MUSIC_DEFAULT_DURATION=120  # Optional — default track duration in seconds

# =============================================================================
# OPENAI WHISPER (Audio Agent — caption fallback on stitched track)
# =============================================================================

OPENAI_API_KEY=                    # Required only if Whisper fallback is triggered
WHISPER_MODEL=whisper-1            # Optional — model size; default whisper-1

# =============================================================================
# YOUTUBE (Publishing Agent — main episode + Shorts)
# =============================================================================

YOUTUBE_CLIENT_ID=                 # Required — OAuth 2.0 client ID
YOUTUBE_CLIENT_SECRET=             # Required — OAuth 2.0 client secret
YOUTUBE_REFRESH_TOKEN=             # Required — long-lived refresh token for offline access; issued via one-time interactive OAuth flow before M5
YOUTUBE_CHANNEL_ID=                # Required — target channel for all uploads
YOUTUBE_DEFAULT_CATEGORY_ID=27     # Optional — YouTube category ID; 27 = Education

# =============================================================================
# TIKTOK (Publishing Agent — conditional; graceful skip on unavailability)
# =============================================================================

TIKTOK_CLIENT_KEY=                 # Required if TikTok API available
TIKTOK_CLIENT_SECRET=              # Required if TikTok API available
TIKTOK_ACCESS_TOKEN=               # Required if TikTok API available — refresh per OAuth flow
TIKTOK_OPEN_ID=                    # Required if TikTok API available — user Open ID

# =============================================================================
# META GRAPH API (Publishing Agent — Instagram Reels + Facebook Video)
# =============================================================================

META_APP_ID=                       # Required
META_APP_SECRET=                   # Required
META_ACCESS_TOKEN=                  # Required — long-lived page access token; 60-day expiry; set calendar reminder at 55 days
META_INSTAGRAM_ACCOUNT_ID=         # Required — for Reels publishing
META_FACEBOOK_PAGE_ID=             # Required — for Facebook Video publishing
META_GRAPH_API_VERSION=v19.0       # Optional — Meta Graph API version string; default v19.0
META_STAGING_BASE_URL=             # Required for Instagram Reels — base URL for public video staging (see platform-publishing-integration.md §5.H)
