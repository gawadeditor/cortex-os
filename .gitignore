# Generated assets — never commit
.hypogeum-assets/
.hypogeum-assets-backup-*/
.hypogeum-review/

# Secrets
.env
client_secret*.json
client_secrets.json

# Claude Code session data — ignored by default; only the versioned
# Graphify project-scoped skill setup is tracked (see docs/architecture/
# GRAPHIFY_FIRST_WORKFLOW.md). .claude/settings.json is NOT tracked here:
# it currently mixes Graphify hooks with machine-specific Octogent hooks.
# Reinstall local hook enforcement with `graphify install --project`.
.claude/*
!.claude/CLAUDE.md
!.claude/skills/
.claude/skills/*
!.claude/skills/graphify/
.claude/skills/graphify/*
!.claude/skills/graphify/SKILL.md
!.claude/skills/graphify/.graphify_version
!.claude/skills/graphify/references/
.claude/skills/graphify/references/*
!.claude/skills/graphify/references/*.md

# Octogent integration
.octogent/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# macOS
.DS_Store

# Test artifacts
.pytest_cache/
tests/__pycache__/
hypogeum/__pycache__/

# Graphify generated outputs
graphify-out/
graphify-out/cost.json
graphify-out/cache/

# Ed25519 approval signing key — NEVER commit
*.pem
approval_ed25519_private_key.pem
grant_spec_ep_af078f34.json
operating_grant_spec_*.json
